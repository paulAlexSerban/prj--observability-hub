        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{AWS/Billing,Currency,ServiceName} MetricName=\"EstimatedCharges\"', 'Maximum', 21600)",
          "id": "",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "matchExact": true,
          "statistic": "Maximum",
          "period": "",
          "region": "us-east-1",
          "label": "${PROP('Dim.ServiceName')}"
        }
      ],
      "title": "Estimated charges by service",
      "type": "timeseries"
    },
