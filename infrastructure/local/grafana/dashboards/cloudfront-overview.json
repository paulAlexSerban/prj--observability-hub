      },
      "description": "Cache hit % from CloudFront access logs (x-edge-result-type). Hit / (Hit+Miss+RefreshHit). Free alternative to CloudWatch CacheHitRate (paid additional metrics).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
