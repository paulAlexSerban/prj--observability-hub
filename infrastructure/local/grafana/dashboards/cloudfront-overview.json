      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (site) (count_over_time({job=\"cloudfront\", result_type=\"Hit\"} [$__interval])) / sum by (site) (count_over_time({job=\"cloudfront\", result_type=~\"Hit|Miss|RefreshHit\"} [$__interval])) * 100",
          "legendFormat": "{{site}}",
          "queryType": "range"
        }
      ],
      "title": "Cache hit rate (from access logs)",
