# Copy to .env and fill from: cd ../aws && terraform output -raw access_key_id / secret_access_key

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_REGION=eu-central-1

# Shared CloudFront access-log bucket (owned by prj--personal-portfolio--v3 prod)
CF_LOG_BUCKET=cf-access-logs.paulserban.eu
CF_LOG_REGION=eu-central-1

# Local Grafana (bound to 127.0.0.1 only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
